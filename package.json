{
  "name": "reloops-oss",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "storage:ensure": "node scripts/ensure-storage-buckets.mjs",
    "sync-env": "node scripts/sync-env.mjs",
    "start": "sh scripts/dev-all.sh",
    "dev": "pnpm --filter @reloops/web dev --host 127.0.0.1 --port 6173",
    "dev:all": "sh scripts/dev-all.sh",
    "supabase:start": "sh scripts/supabase-cli.sh start",
    "supabase:reset": "sh scripts/supabase-cli.sh db reset",
    "supabase:share": "sh scripts/supabase-cli.sh functions serve share --env-file .env",
    "supabase:functions": "sh scripts/supabase-cli.sh functions serve --env-file .env",
    "worker:asset-intelligence": "pnpm --filter @reloops/asset-intelligence-worker dev",
    "docker:start": "docker compose up --build",
    "docker:stop": "sh scripts/docker-stop.sh",
    "docker:asset-intelligence": "sh scripts/docker-asset-intelligence-worker.sh",
    "ai:requeue": "node scripts/requeue-asset-intelligence.mjs",
    "build": "pnpm --filter @reloops/web build",
    "lint": "pnpm --filter @reloops/web lint",
    "typecheck": "pnpm --filter @reloops/web typecheck && pnpm --filter @reloops/asset-intelligence-worker build",
    "test": "pnpm typecheck && pnpm test:coverage && pnpm test:contracts && pnpm build",
    "test:unit": "pnpm --filter @reloops/web test:unit",
    "test:coverage": "pnpm --filter @reloops/web test:coverage",
    "test:contracts": "node --experimental-strip-types --test scripts/project-guest-portal.spec.mjs scripts/private-asset-urls.spec.mjs scripts/docker-runtime.spec.mjs && node scripts/smoke-test.mjs && node scripts/collections-ui-regression.mjs",
    "test:browser": "playwright test",
    "test:integration": "RELOOPS_TEST_INTEGRATION=1 playwright test",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "test:project-guest-portal": "node --experimental-strip-types --test scripts/project-guest-portal.spec.mjs",
    "test:private-asset-urls": "node --experimental-strip-types --test scripts/private-asset-urls.spec.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "typescript": "~5.8.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.106.2"
  }
}
