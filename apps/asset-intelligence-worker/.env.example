SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# mock returns deterministic local output. openai calls the OpenAI Responses API.
ASSET_AI_PROVIDER=mock
ASSET_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=

# Public base URL for assets when the model needs to inspect images/video.
# For local OSS this is usually Supabase Storage's public assets bucket URL.
ASSET_SOURCE_BASE_URL=http://127.0.0.1:56321/storage/v1/object/public/assets

ASSET_AI_WORKER_ID=asset-ai-local
ASSET_AI_POLL_INTERVAL_MS=5000
ASSET_AI_LEASE_SECONDS=300
ASSET_AI_MAX_CONCURRENT_JOBS=1
ASSET_AI_OPENAI_TIMEOUT_MS=60000
ASSET_AI_FFMPEG_TIMEOUT_MS=30000
ASSET_AI_FFPROBE_TIMEOUT_MS=10000
ASSET_AI_MAX_VIDEO_FRAMES=3
ASSET_AI_VIDEO_FRAME_WIDTH=720
