# Copy this file to .env, then run pnpm start.
# Local Supabase URL/keys are auto-filled by pnpm start.
# Add OPENAI_API_KEY and set ASSET_AI_PROVIDER=openai for real AI metadata.

VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_APP_URL=http://localhost:6173
VITE_ASSET_PUBLIC_BASE_URL=http://127.0.0.1:56321/storage/v1/object/public/assets/
VITE_RELOOPS_OSS=true

SUPABASE_URL=http://127.0.0.1:56321
SUPABASE_PUBLIC_URL=http://127.0.0.1:56321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
URL_SUPABASE=http://127.0.0.1:56321
ANON_KEY=replace-with-local-anon-key
SERVICE_ROLE_KEY=replace-with-local-service-role-key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long
FRONTEND_URL=http://localhost:6173

ASSET_SOURCE_BASE_URL=http://127.0.0.1:56321/storage/v1/object/public/assets
ASSET_AI_PROVIDER=mock
ASSET_AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ASSET_AI_WORKER_ID=asset-ai-local
ASSET_AI_POLL_INTERVAL_MS=5000
ASSET_AI_LEASE_SECONDS=300
ASSET_AI_MAX_CONCURRENT_JOBS=1
ASSET_AI_OPENAI_TIMEOUT_MS=60000
ASSET_AI_FFMPEG_TIMEOUT_MS=30000
ASSET_AI_FFPROBE_TIMEOUT_MS=10000
ASSET_AI_MAX_VIDEO_FRAMES=3
ASSET_AI_VIDEO_FRAME_WIDTH=720
